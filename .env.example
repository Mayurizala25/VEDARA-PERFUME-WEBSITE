# VEDARA — environment template.
# Copy to `.env.local` and fill in with your own Supabase project values.
#
#   Supabase Dashboard → Project Settings → API
#   - Project URL              -> VITE_SUPABASE_URL
#   - Project API keys: anon / publishable  -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# The publishable/anon key is safe to expose in the browser (RLS protects data).
# NEVER put the service_role key in this project — it bypasses RLS.
#
# If both values are blank the storefront falls back to the local demo catalogue.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Admin → Sheet Orders (Google Sheets) — SERVER-ONLY, used by api/sheet-orders.js
#
# Deliberately NOT prefixed with VITE_ — Vite only exposes VITE_-prefixed
# vars to the browser bundle, so these stay on the server and are never
# shipped to the frontend.
#
# Setup:
#   1. Google Cloud Console → create/select a project → enable the
#      "Google Sheets API".
#   2. IAM & Admin → Service Accounts → Create service account → Keys →
#      Add key → JSON. Open the downloaded file for the two values below.
#   3. Open your "VEDARA Orders" Google Sheet → Share → paste the service
#      account's client_email → give it Editor access.
#   4. Copy the spreadsheet ID from its URL:
#      https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
#
# Set these in Vercel → Project Settings → Environment Variables (Production
# + Preview) as well as here for local `vercel dev`.

GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKey...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-spreadsheet-id
# Tab name inside the spreadsheet — defaults to "Sheet1" if unset.
GOOGLE_SHEETS_TAB_NAME=Sheet1
