# VEDARA — environment template.
# Copy to `.env.local` and fill in with your own Supabase project values.
#
#   Supabase Dashboard → Project Settings → API
#   - Project URL              -> VITE_SUPABASE_URL
#   - Project API keys: anon / publishable  -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# The publishable/anon key is safe to expose in the browser (RLS protects data).
# NEVER put the service_role key in this project — it bypasses RLS.
#
# If both values are blank the storefront falls back to the local demo catalogue.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
