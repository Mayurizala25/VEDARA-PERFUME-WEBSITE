# VEDARA — environment template.
# Copy to `.env.local` and fill in with your own Supabase project values.
#
#   Supabase Dashboard → Project Settings → API
#   - Project URL              -> VITE_SUPABASE_URL
#   - Project API keys: anon / publishable  -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# The publishable/anon key is safe to expose in the browser (RLS protects data).
# NEVER put the service_role key in this project — it bypasses RLS.
#
# If both values are blank the storefront falls back to the local demo catalogue.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Admin → Orders → "Connect Google Sheet"
#
# Browser-only OAuth (Google Identity Services) — an admin authorizes THIS
# site, in a popup, to read/write the one spreadsheet below. Neither value
# is a secret (a Client ID and a spreadsheet ID are both meant to be public),
# so both stay VITE_-prefixed like the Supabase values above. There is no
# client secret and no service account anywhere in this project.
#
# Setup:
#   1. Google Cloud Console → APIs & Services → Credentials → Create
#      Credentials → OAuth client ID → Web application.
#   2. Add this site's URL(s) under "Authorized JavaScript origins"
#      (e.g. https://vedaraperfumewebsite.vercel.app and
#      http://localhost:5173 for local dev). No redirect URI is needed.
#   3. Copy the Client ID it gives you.
#   4. Copy the spreadsheet ID from its URL:
#      https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
#   5. Make sure the Google account you'll click "Connect" with already has
#      edit access to that spreadsheet.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_SHEETS_ID=your-spreadsheet-id
# Optional — defaults to the sheet's first tab if unset.
VITE_GOOGLE_SHEETS_TAB_NAME=
